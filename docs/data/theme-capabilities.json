          "markup": "<section class=\"rdk-dark-horse-workspace\" aria-labelledby=\"dh-doc-workspace-title\"><header class=\"flex items-center justify-between gap-3 p-3\"><div><span class=\"rdk-label\">Operational workspace</span><h2 id=\"dh-doc-workspace-title\">Station 04</h2></div><span class=\"rdk-dark-horse-micro-status\" data-state=\"neutral\">Local</span></header><div class=\"grid gap-3 p-3 sm:grid-cols-[9rem_minmax(0,1fr)]\"><aside class=\"grid content-start gap-1\" aria-label=\"Workspace navigation\"><span class=\"rdk-label\">Workspace</span><a href=\"#workspace-overview\" class=\"rdk-nav-item\" aria-current=\"page\"><span class=\"rdk-nav-item-label\">Overview</span></a><a href=\"#workspace-telemetry\" class=\"rdk-nav-item\"><span class=\"rdk-nav-item-label\">Telemetry</span></a></aside><div id=\"workspace-overview\" class=\"grid min-w-0 gap-3\"><div class=\"rdk-dark-horse-instrument\" data-variant=\"accent\" role=\"group\" aria-label=\"System load\"><div class=\"rdk-dark-horse-instrument-header\"><span class=\"rdk-dark-horse-instrument-title\">System load</span><span class=\"rdk-dark-horse-instrument-mark\" aria-hidden=\"true\"></span></div><div class=\"rdk-dark-horse-instrument-readings\"><div class=\"rdk-dark-horse-instrument-channel\"><span class=\"rdk-dark-horse-instrument-value-line\"><strong class=\"rdk-dark-horse-instrument-value\">38</strong><span class=\"rdk-dark-horse-instrument-unit\">%</span></span><span class=\"rdk-dark-horse-instrument-meta\">All services online</span></div></div></div><div id=\"workspace-telemetry\" class=\"rdk-dark-horse-telemetry-row\"><span class=\"rdk-dark-horse-telemetry-label\">GPU load</span><strong class=\"rdk-dark-horse-telemetry-value\">78%</strong><span class=\"rdk-dark-horse-telemetry-state\">Active</span></div></div></div></section>"
