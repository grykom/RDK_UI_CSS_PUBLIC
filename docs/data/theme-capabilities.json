          "classes": [
            "rdk-dark-horse-control-panel"
          ],
          "description": "Dark Horse composition for a contained, medium-density operational interface. The application owns shell geometry.",
          "markup": "<section class=\"rdk-dark-horse-control-panel\" aria-labelledby=\"dh-doc-panel-title\"><header><h2 id=\"dh-doc-panel-title\">Control Panel</h2><span class=\"rdk-dark-horse-micro-status\" data-state=\"success\">Connected</span></header><div class=\"grid gap-3 p-3 sm:grid-cols-2\"><section class=\"rdk-card grid gap-2 p-3\" aria-label=\"Host readings\"><h3 class=\"rdk-label\">Host / Station 04</h3><div class=\"rdk-dark-horse-instrument\" data-variant=\"success\" role=\"group\" aria-label=\"CPU temperature\"><div class=\"rdk-dark-horse-instrument-header\"><span class=\"rdk-dark-horse-instrument-title\">CPU temperature</span><span class=\"rdk-dark-horse-instrument-mark\" aria-hidden=\"true\"></span></div><div class=\"rdk-dark-horse-instrument-readings\"><div class=\"rdk-dark-horse-instrument-channel\"><span class=\"rdk-dark-horse-instrument-value-line\"><strong class=\"rdk-dark-horse-instrument-value\">65</strong><span class=\"rdk-dark-horse-instrument-unit\">C</span></span><span class=\"rdk-dark-horse-instrument-meta\">Within range</span></div></div></div></section><section class=\"rdk-card grid gap-2 p-3\" aria-label=\"Display output\"><h3 class=\"rdk-label\">Output</h3><button type=\"button\" class=\"rdk-card rdk-card-interactive rdk-dark-horse-device-tile\" aria-pressed=\"true\"><span class=\"rdk-dark-horse-device-tile-copy\"><strong class=\"rdk-dark-horse-device-tile-name\">Desk Monitor</strong><small class=\"rdk-dark-horse-device-tile-meta\">2560 x 1440 / 144 Hz</small></span><span class=\"rdk-dark-horse-device-tile-state\">Selected</span></button></section><section class=\"rdk-card p-3 sm:col-span-2\" aria-label=\"Network status\"><div class=\"rdk-dark-horse-status\" data-state=\"success\"><span class=\"rdk-dark-horse-status-mark\" aria-hidden=\"true\"></span><span class=\"rdk-dark-horse-status-name\">Network</span><strong class=\"rdk-dark-horse-status-value\">Connected</strong></div></section></div></section>"
