      "themeSpecific": {
        "terminal-window": {
          "label": "Terminal Window",
          "classes": [
            "rdk-terminal-window",
            "rdk-terminal-window-bar",
            "rdk-terminal-window-body"
          ],
          "description": "A scoped window for a terminal session. Colored dots are decoration; application CSS owns page layout.",
          "markup": "<section class=\"rdk-terminal-window\" aria-label=\"Terminal session\"><header class=\"rdk-terminal-window-bar\">Session</header><div class=\"rdk-terminal-window-body\"><p>node-01:~$ status</p></div></section>"
        },
        "terminal-prompt": {
          "label": "Terminal Prompt",
          "classes": [
            "rdk-terminal-prompt"
          ],
          "description": "Visual treatment for selectable application-owned prompt text. No username, path, or command is generated by CSS.",
          "markup": "<p><span class=\"rdk-terminal-prompt\">gaming@omv:~$</span> status</p>"
        },
        "terminal-cursor": {
          "label": "Terminal Cursor",
          "classes": [
            "rdk-terminal-cursor"
          ],
          "description": "Decorative block cursor. Hide it from assistive technology; application code owns editing and focus. Reduced motion keeps it visible and still.",
          "markup": "<p><span class=\"rdk-terminal-prompt\">gaming@omv:~$</span> <span class=\"rdk-terminal-cursor\" aria-hidden=\"true\"></span></p>"
        },
        "terminal-marker": {
          "label": "Terminal Marker",
          "classes": [
            "rdk-terminal-marker"
          ],
          "description": "Textual status marker with neutral, progress, info, success, warning, danger or muted tone. Progress means active/waiting and uses amber; info stays cyan. Keep meaningful text in HTML; muted is de-emphasis, not neutral.",
          "markup": "<p><span class=\"rdk-terminal-marker\" data-tone=\"success\">[ OK ]</span> Service ready</p>"
        }
      },
      "recipes": [
        "terminal-session"
      ],
      "recommendations": {
        "toggle": "Use Checkbox for a native boolean choice.",
        "badge": "Use text status or Notice for key states.",
